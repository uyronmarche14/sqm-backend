# Database Configuration
# Microsoft SQL Server

# Server connection
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=master # NOTE: Change this to your actual SQM database name
DB_USER=sa
DB_PASSWORD=YourStrong!Pass123

# SSL/TLS options
DB_ENCRYPT=true
DB_TRUST_CERT=true

# Application
PORT=3001
FRONTEND_BASE_URL=http://localhost:5173

# Email Notifications
EMAIL_ENABLED=true
EMAIL_TRANSPORT=file
EMAIL_FROM=noreply@sqm.local
EMAIL_FROM_NAME=SQM Notifications
EMAIL_LOGIN_PATH=/auth/login
EMAIL_OUTPUT_DIR=tmp/emails
EMAIL_LOCAL_BASE_URL=http://localhost:5173
EMAIL_INTERNET_BASE_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# JWT Secrets
JWT_SECRET=development-secret-key-12345
JWT_REFRESH_SECRET=development-refresh-secret-key-67890
JWT_EXPIRES_IN=8h
