# Local Development Configuration using Docker SQL Server
# Uses Docker SQL Server on port 1443
# Database Configuration
DB_HOST=localhost
DB_PORT=1443
DB_NAME=sqm
DB_USER=sa
DB_PASSWORD=StrongPassword123!
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Application
PORT=5001

# JWT Secrets
JWT_SECRET=development-secret-key-12345
JWT_REFRESH_SECRET=development-refresh-secret-key-67890
JWT_EXPIRES_IN=8h